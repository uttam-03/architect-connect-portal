PORT=5000
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
DB_DIALECT=sqlite
SQLITE_PATH=./data/architect_connect.sqlite
AUTO_BACKUP=true
# For a separate frontend only; same-origin Render needs no CLIENT_URL.
CLIENT_URL=http://localhost:5173
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional MySQL (use an external persistent database):
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=architect_connect
MYSQL_USER=root
MYSQL_PASSWORD=
